[Unit]
Description=DreamByte OS TV - sesión de pantalla (Cage + navegador)
After=systemd-user-sessions.service systemd-logind.service live-config.service getty@tty1.service
Wants=dbus.socket systemd-logind.service live-config.service
Conflicts=getty@tty1.service
StartLimitIntervalSec=0

[Service]
Type=simple
User=dreambyte
PAMName=login
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty-fail
StandardOutput=journal
StandardError=journal
UtmpIdentifier=tty1
UtmpMode=user
Environment=XDG_SESSION_TYPE=wayland
ExecStart=/usr/local/bin/dreambyte-session
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
